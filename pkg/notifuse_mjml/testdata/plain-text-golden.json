{
  "id": "root",
  "type": "mjml",
  "children": [
    {
      "id": "head",
      "type": "mj-head",
      "children": [
        { "id": "preview", "type": "mj-preview", "content": "Our spring collection is here" }
      ]
    },
    {
      "id": "body",
      "type": "mj-body",
      "children": [
        {
          "id": "nav-section",
          "type": "mj-section",
          "children": [
            {
              "id": "nav-column",
              "type": "mj-column",
              "children": [
                {
                  "id": "logo",
                  "type": "mj-image",
                  "attributes": { "src": "https://cdn.example.com/logo.png", "alt": "Acme", "href": "https://www.example.com/" }
                },
                {
                  "id": "nav",
                  "type": "mj-text",
                  "content": "<div style=\"text-align:center\"><a href=\"https://www.example.com/shop\">Shop</a><a href=\"https://www.example.com/blog\">Blog</a><a href=\"https://www.example.com/help\">Help</a></div>"
                }
              ]
            }
          ]
        },
        {
          "id": "content-section",
          "type": "mj-section",
          "children": [
            {
              "id": "content-column",
              "type": "mj-column",
              "children": [
                { "id": "heading", "type": "mj-text", "content": "<h1>Hello {{ contact.first_name }}</h1>" },
                {
                  "id": "intro",
                  "type": "mj-text",
                  "content": "<p>Our spring collection is in store. Read <a href=\"https://www.example.com/blog/spring\">the story behind it</a>.</p><ul><li>Linen shirts</li><li>Canvas shoes</li></ul>"
                },
                {
                  "id": "button",
                  "type": "mj-button",
                  "attributes": { "href": "https://www.example.com/spring?ref=email&amp;size=m" },
                  "content": "Shop the collection"
                },
                { "id": "divider", "type": "mj-divider" },
                {
                  "id": "social",
                  "type": "mj-social",
                  "children": [
                    { "id": "fb", "type": "mj-social-element", "attributes": { "name": "facebook", "href": "https://facebook.com/acme" }, "content": "Facebook" },
                    { "id": "ig", "type": "mj-social-element", "attributes": { "name": "instagram", "href": "https://instagram.com/acme" }, "content": "Instagram" }
                  ]
                },
                {
                  "id": "footer",
                  "type": "mj-text",
                  "content": "<p>Acme, 1 Market Street, Lyon</p><p><a href=\"{{ unsubscribe_url }}\">Unsubscribe</a> · <a href=\"mailto:help@example.com\">help@example.com</a></p>"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
